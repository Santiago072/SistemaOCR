# Configuracion para XAMPP - Sistema OCR
Options -Indexes

# Aumentar limites de PHP para archivos grandes (PDFs de cédulas)
<IfModule mod_php.c>
    php_value upload_max_filesize 100M
    php_value post_max_size 100M
    php_value max_execution_time 600
    php_value memory_limit 512M
</IfModule>

# Proteger archivos sensibles
<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env|composer\.(json|lock)|BD\.txt)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Bloquear acceso directo a carpetas privadas con mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /SistemaOCR/
    RewriteRule ^(app|config|database|python_ocr|vendor)(/|$) - [F,L]
</IfModule>
